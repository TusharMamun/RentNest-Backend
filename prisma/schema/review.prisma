model Review {
  id         String  @id @default(uuid())
  rating     Int     @db.SmallInt // 
  comment    String? @db.Text
  tenantId   String
  propertyId String
 rentelRequestId String
  // Relations
  tenant   User     @relation("TenantReviews", fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
 rentel RentalRequest @relation(fields: [rentelRequestId],references: [id],onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, propertyId])
  @@map("review")
}

model Category {
  id           String     @id @default(uuid())
  catagoryName String     @unique @db.VarChar(100)
  properties   Property[]
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  CreatedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catagory")
}

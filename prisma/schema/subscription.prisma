model Subscription {
  id               String        @id @default(uuid())
  tenantId         String        // @unique বাদ দেওয়া হয়েছে
  tenant           User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  rentRequestid    String        @unique // প্রতিটি Rental Request এর জন্য ১টিই Subscription
  rentelrequest    RentalRequest @relation(fields: [rentRequestid], references: [id], onDelete: Cascade)
  
  status           PaymentStatus @default(PENDING)
  totalAmount      Float
  stripeCustomerId String?    
  trasectionId String?
  currentPeriodEnd DateTime      @default(now())
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("subscription")
}